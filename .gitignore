# Dependencies
node_modules/

# Build output. NOT committed: dist statically imports typescript, openai and the
# MCP SDK, so a checkout without `node_modules` cannot run it no matter what is in
# here -- `npm install` was never optional, and the `prepare` script builds during
# it. That covers `npm i github:Texalva/quality-gate-sgd` too, since npm runs
# `prepare` for git dependencies.
#
# Tracking it also made "the committed build matches the committed source" an
# invariant with nothing enforcing it, which matters here more than in most repos:
# tools/refactor-harness verifies through the shipped dist/cli.js, so a dist that
# lags src grades one version while the test suite grades another.
dist/

# Cache files
.quality-gate-cache.json

# Coverage reports
coverage/
coverage-lambda/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets
.sonarqube-token
*.token

# Internal development notes (not for public)
.internal-*.md

# Logs
*.log
npm-debug.log*

# Test output
.scannerwork/

# Per-file scratch dirs for the experiment suites (see scaffold.test.ts)
.test-experiments*/
